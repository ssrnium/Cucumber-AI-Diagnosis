# cucumber-agent 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 排除，勿提交）
# 注意：宿主机若存在全局 ANTHROPIC_* 环境变量会覆盖本文件，启动时请确认或显式注入

# LLM（Anthropic 兼容协议；DeepSeek 官方端点示例）
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-chat

# 平台服务地址
CUCUMBER_ADMIN_URL=http://localhost:8080
CUCUMBER_AI_URL=http://localhost:8000

# svc-agent 服务账号密码（admin 回调业务接口用，与 DataInitializer 中一致）
AGENT_SERVICE_PASSWORD=SvcAgent@123

# 记忆与向量库（嵌入式默认即可；服务端模式时改 CHROMA_HOST）
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=../data/chroma
