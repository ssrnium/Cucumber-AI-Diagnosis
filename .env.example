# 黄瓜诊断平台 — docker-compose 根级环境变量模板
# 用法：cp .env.example .env，填 key 后 docker compose up -d --build
# （.env 已被 .gitignore 排除，勿提交）

# LLM：报告润色提供方（mock=本地确定性润色，无需 key；deepseek=真实 LLM 链路）
LLM_PROVIDER=deepseek

# Kimi k3（论文同端点，备选；LLM_PROVIDER=kimi 时必填）
KIMI_API_KEY=

# 智能体（Anthropic 兼容协议，DeepSeek 官方端点）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

# svc-agent 服务账号密码（与 admin 初始化一致）
SVC_AGENT_PASSWORD=SvcAgent@123

# JWT 签名密钥（公网部署务必改为长随机串）
JWT_SECRET=please-change-me-to-a-long-random-string
