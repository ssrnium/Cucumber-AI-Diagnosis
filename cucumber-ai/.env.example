# cucumber-ai 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 排除，勿提交）

# LLM 提供方：kimi（论文同端点，默认）/ deepseek（备用，同流水线同校验）
LLM_PROVIDER=kimi

# Kimi（k3，论文第六章同端点）
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# DeepSeek 备用通道
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 模型权重与知识库（默认值即可，一般不用改）
WEIGHTS_PATH=weights/E2_gfix.pt
KNOWLEDGE_PATH=data/disease_knowledge.json
